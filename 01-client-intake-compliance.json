{
  "name": "01 - Client Intake & Compliance Gate",
  "nodes": [
    {
      "parameters": {
        "content": "## 01 \u2014 Client Intake & Compliance Gate\n\n**Trigger:** the app POSTs a new client here.\n\nThis workflow is the CROA compliance gate. It refuses to create a case unless the client has been shown the *Consumer Credit File Rights* disclosure, signed the services contract, and given written consent. It then opens a mandatory 3-business-day cancellation window \u2014 no dispute work happens until that window closes.\n\n**No upfront fees may be charged before services are performed.**",
        "height": 320,
        "width": 460,
        "color": 4
      },
      "id": "10821bdd-4046-40c4-af01-9afffd97a449",
      "name": "Note 36ca507a",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -640,
        -380
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "credit-repair/intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a533477f-adf7-482b-903e-852eabb81707",
      "name": "Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validate the intake payload before anything is written.\nconst data = $input.first().json.body || $input.first().json;\nconst required = ['first_name','last_name','email','phone',\n  'date_of_birth','ssn_last4','street','city','state','zip',\n  'plan_tier','consent_given','disclosure_acknowledged',\n  'croa_contract_signed','credit_data_source'];\nconst missing = required.filter(k =>\n  data[k] === undefined || data[k] === null || data[k] === '');\nconst compliant = data.consent_given === true\n  && data.disclosure_acknowledged === true\n  && data.croa_contract_signed === true;\nreturn [{ json: { ...data,\n  _missing: missing,\n  _valid: missing.length === 0,\n  _compliant: compliant } }];"
      },
      "id": "ff7cdb51-8b04-48b0-9653-132d3dd2a502",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "dd43ef6e-d329-42fc-9cb2-e0995d8458e2",
              "leftValue": "={{ $json._valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "05c8e602-fbf2-4892-a109-e7c1911f9850",
              "leftValue": "={{ $json._compliant }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "06758cf4-620f-48ae-86f1-9ec174b6b0df",
      "name": "Compliance Gate Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "3fbf3a14-8988-47f2-b5fc-11f3a81b2816",
              "name": "case_status",
              "value": "cooling_off",
              "type": "string"
            },
            {
              "id": "4af329d0-4308-4b03-a195-bd809e3057b1",
              "name": "intake_received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "742d650a-cef5-4e83-8614-505f202478b1",
              "name": "cancellation_deadline",
              "value": "={{ $now.plus({ days: 3 }).toISO() }}",
              "type": "string"
            },
            {
              "id": "06e1a510-896b-4469-bf9a-a70df7e5cef4",
              "name": "upfront_fee_charged",
