{
  "name": "06 - Response Tracking & Escalation",
  "nodes": [
    {
      "parameters": {
        "content": "## 06 \u2014 Response Tracking & Escalation\n\nRuns daily. Finds letters whose FCRA 30-day reinvestigation window has closed, re-pulls the report, and compares: which items were **deleted**, **verified**, or **ignored**. Claude recommends the next move; resolved cases close, unresolved items escalate to the next dispute round (re-entering Workflow 04).",
        "height": 270,
        "width": 470,
        "color": 4
      },
      "id": "da9ce237-31a3-404e-aa73-e195c89fc1b6",
      "name": "Note c663f916",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -720,
        -440
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "989edbef-e1a8-4e81-ac82-5d315fb89521",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT case_id\nFROM dispute_letters\nWHERE letter_status = 'mailed'\n  AND fcra_response_due < now();",
        "options": {}
      },
      "id": "f13e1872-017f-40e3-9759-43675ce298ed",
      "name": "DB: Letters Past FCRA Window",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
