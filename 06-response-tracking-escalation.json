    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE cases SET current_round = COALESCE(current_round,1) + 1,\n  case_status = 'escalating'\nWHERE case_id = $1 RETURNING current_round;",
        "options": {}
      },
