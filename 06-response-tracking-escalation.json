      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "0efd696d-77e8-46e1-9b53-9ebce67d5964",
      "name": "Loop Over Cases",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "id",
          "cachedResultName": "02 - Credit Report Ingestion"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "case_id": "={{ $json.case_id }}"
          }
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "2f37d64f-ea97-4186-a06d-47e308ff8889",
      "name": "Re-Ingest Updated Report",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT item_id, creditor, bureau, dispute_basis,\n       prior_status, reported_status,\n       CASE\n         WHEN reported_status IS NULL THEN 'deleted'\n         WHEN reported_status = prior_status THEN 'verified'\n         ELSE 'changed' END AS outcome\nFROM negative_items WHERE case_id = $1;",
        "options": {}
      },
      "id": "b2c9991f-8cc9-4d16-a95f-1f91112a0a30",
      "name": "DB: Compare Item States",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        740,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ask Claude to evaluate the round and recommend next steps.\nconst rows = $input.all().map(i => i.json);\nconst caseId = rows.length ? rows[0].case_id : null;\nconst system = 'You are an FCRA strategist. Given the outcome of a '\n  + 'dispute round, recommend the next action. Items still verified '\n  + 'without adequate proof may escalate (Method of Verification, '\n  + 'then furnisher dispute). Never recommend disputing items that '\n  + 'were correctly verified and are accurate. Return ONLY JSON.';\nconst user = 'Round outcomes: ' + JSON.stringify(rows, null, 2)\n  + '\\nReturn JSON: {\"case_outcome\": one of '\n  + '[\"all_resolved\",\"partial\",\"no_progress\"], '\n  + '\"escalate\": boolean, \"next_round_items\": [item_id], '\n  + '\"summary\": string}';\nreturn [{ json: { case_id: caseId, anthropic_request: {\n  model: 'claude-sonnet-4-6', max_tokens: 1024,\n  system, messages: [{ role: 'user', content: user }] } } }];"
      },
      "id": "ebb66d44-7807-486c-8138-5440fe0288d9",
      "name": "Build Outcome Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.anthropic_request) }}",
        "options": {}
      },
      "id": "76dbaecd-497e-4743-882f-49d46f067c9b",
      "name": "Claude: Evaluate Round",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst text = (resp.content && resp.content[0] && resp.content[0].text) || '{}';\nlet v;\ntry { v = JSON.parse(text.match(/\\{[\\s\\S]*\\}/)[0]); }\ncatch (e) { v = { case_outcome: 'partial', escalate: true,\n  next_round_items: [], summary: 'parse_error' }; }\nconst caseId = $('Build Outcome Prompt').first().json.case_id;\nreturn [{ json: { case_id: caseId, ...v } }];"
      },
      "id": "323b87b3-0089-4ee2-9fc3-a618c222abe1",
      "name": "Parse Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        0
      ]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "74814a41-7f20-44e8-86ad-163fccb92128",
                    "leftValue": "={{ $json.case_outcome }}",
                    "rightValue": "all_resolved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Resolved"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "a31df383-945b-4b20-936c-8dc2ce078788",
      "name": "Resolved or Escalate?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1700,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE cases SET case_status = 'resolved', closed_at = now()\nWHERE case_id = $1;",
        "options": {}
      },
      "id": "423c0627-7162-4224-abd3-664edae4f059",
      "name": "DB: Close Case",
