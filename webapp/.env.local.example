# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────────
# Settings > API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (Claude LLM) ────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Voyage AI (embeddings) ────────────────────────────────────
# dash.voyageai.com → API Keys
VOYAGE_AI_API_KEY=pa-your-voyage-key-here

# ── n8n ───────────────────────────────────────────────────────
# n8n instance base URL (no trailing slash)
N8N_API_URL=https://your-instance.app.n8n.cloud
# n8n → Settings → API → Create API key
N8N_API_KEY=your-n8n-api-key

# n8n webhook URLs (used by Next.js server actions)
NEXT_PUBLIC_N8N_INTAKE_WEBHOOK=https://your-instance.app.n8n.cloud/webhook/credit-repair/intake
N8N_APPROVAL_WEBHOOK=https://your-instance.app.n8n.cloud/webhook/credit-repair/letters/approve

# ── Admin ─────────────────────────────────────────────────────
# This email address is routed to /admin after magic-link login
ADMIN_EMAIL=williamsequitycapital@gmail.com
