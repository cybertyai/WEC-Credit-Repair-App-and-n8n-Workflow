{
  "name": "07 - Client Notifications",
  "nodes": [
    {
      "parameters": {
        "content": "## 07 \u2014 Client Notifications\n\nShared notification service. Called by other workflows with an `event_type` and `case_id`. Sends a templated email (and optional SMS) and logs every message for the audit trail CROA expects.",
        "height": 220,
        "width": 440,
        "color": 4
      },
      "id": "f6a2d8a6-4a40-4ce8-ab6d-960ef8e4e700",
      "name": "Note 584bcdd3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -640,
        -360
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "e185f830-eb42-49b9-add2-d91cda7e8989",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -180,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT case_id, first_name, last_name, email, phone, sms_opt_in\nFROM cases WHERE case_id = $1;",
        "options": {}
      },
      "id": "62e93317-6574-4beb-9474-07840c9bd5de",
      "name": "DB: Get Client Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        60,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Templated copy keyed on event_type.\nconst ctx = $('When Called').first().json;\nconst c = $input.first().json;\nconst t = {\n  intake_confirmed: {\n    subject: 'Welcome to Williams Equity Capital - your case is open',\n    body: 'Hi ' + c.first_name + ', your case is open. Your 3-day '\n      + 'cancellation window is running; dispute work starts after '\n      + 'it closes. You owe nothing until services are performed.' },\n  letters_mailed: {\n    subject: 'Your dispute letters are on the way',\n    body: 'Hi ' + c.first_name + ', your round of dispute letters '\n      + 'has been mailed certified to the credit bureaus. They have '\n      + '30 days to respond.' },\n  round_results: {\n    subject: 'Update on your credit dispute round',\n    body: 'Hi ' + c.first_name + ', the bureaus have responded. '\n      + 'Log in to see which items were removed or corrected and '\n      + 'what happens next.' },\n  case_closed: {\n    subject: 'Your credit repair case is complete',\n    body: 'Hi ' + c.first_name + ', all disputable items have been '\n      + 'resolved. A summary is available in your portal.' }\n};\nconst msg = t[ctx.event_type] || t.round_results;\nreturn [{ json: { ...c, event_type: ctx.event_type,\n  subject: msg.subject, body: msg.body } }];"
      },
      "id": "ecf24757-98a7-4156-9e47-f11593be6abe",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "support@williamsequitycapital.com",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {}
      },
      "id": "e52ae84e-feba-4cac-90db-de2cbee93ce7",
      "name": "Send Email",
